<!-- TEMPLATE — rename to <App>Plugin.csproj. The ..\..\libs HintPaths are correct when the
     project lives at <repo root>/myplugins/<App>Plugin/ (adjust the depth for other locations).
     Use TargetFramework net10.0-windows10.0.19041.0 instead of net10.0 only when Windows-only
     APIs are needed. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AppPlugin</AssemblyName>
    <!-- Put NuGet dependencies in the build output so the whole output can be copied into Lib/. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>
  <!-- Private=false: ManicTime provides these host assemblies. Copying them into the plugin's
       Lib/ folder breaks loading, so keep them out of the build output — then the whole output
       (your dll + NuGet dependencies) can be copied straight into Lib/. -->
  <ItemGroup>
    <Reference Include="Finkit.ManicTime.Shared" Private="false">
      <HintPath>..\..\libs\Finkit.ManicTime.Shared.dll</HintPath>
    </Reference>
    <Reference Include="ManicTime.Api" Private="false">
      <HintPath>..\..\libs\ManicTime.Api.dll</HintPath>
    </Reference>
    <Reference Include="ManicTime.Client.Tracker" Private="false">
      <HintPath>..\..\libs\ManicTime.Client.Tracker.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
